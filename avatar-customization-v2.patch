diff --git a/app/api/kids/character/avatar/route.ts b/app/api/kids/character/avatar/route.ts
new file mode 100644
index 0000000..5316e7b
--- /dev/null
+++ b/app/api/kids/character/avatar/route.ts
@@ -0,0 +1,40 @@
+import { NextResponse } from "next/server";
+import { createClient } from "@/lib/supabase/server";
+import { SKIN_TONE_SWATCHES, BODY_TYPE_IMAGE, type AvatarBodyType } from "@/lib/character";
+
+const VALID_BODY_TYPES = Object.keys(BODY_TYPE_IMAGE) as AvatarBodyType[];
+
+export async function POST(request: Request) {
+  const supabase = await createClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user) return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
+
+  const { skinTone, bodyType } = (await request.json()) as {
+    skinTone?: string;
+    bodyType?: AvatarBodyType;
+  };
+
+  const update: Record<string, string> = {};
+  if (skinTone !== undefined) {
+    if (!SKIN_TONE_SWATCHES.includes(skinTone)) {
+      return NextResponse.json({ error: "Not a valid skin tone" }, { status: 400 });
+    }
+    update.skin_tone = skinTone;
+  }
+  if (bodyType !== undefined) {
+    if (!VALID_BODY_TYPES.includes(bodyType)) {
+      return NextResponse.json({ error: "Not a valid body type" }, { status: 400 });
+    }
+    update.avatar_body_type = bodyType;
+  }
+  if (Object.keys(update).length === 0) {
+    return NextResponse.json({ error: "Nothing to update" }, { status: 400 });
+  }
+
+  // Self-write: users_update_own (migration 001) already permits this.
+  const { error } = await supabase.from("users").update(update).eq("id", user.id);
+  if (error) return NextResponse.json({ error: error.message }, { status: 500 });
+  return NextResponse.json({ ok: true });
+}
