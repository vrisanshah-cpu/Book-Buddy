+-- Avatar customization v2 — adds skin tone + body-shape presets, and 5 new
+-- cosmetic slots (aura, headwear, eyewear, handheld, shelf_theme) on top of
+-- migration 031's paper-doll system.
+--
+-- Body *shape* becomes a free preset toggle (skin_tone + avatar_body_type
+-- below) instead of a purchasable cosmetic — there was only ever one "body"
+-- item in the shop ("Default", is_starter), so nothing purchasable is lost.
+-- The 'body' slot stays valid in cosmetic_items for backward compatibility
+-- (existing rows, and the check constraint), but nothing reads
+-- equipped_body_id to drive rendering anymore — see
+-- lib/character.ts:resolveAvatarBase() and components/kids/CharacterCanvas.tsx.
+--
+-- shelf_theme rejoins cosmetic_items (it briefly lived only as a shop_items
+-- category before 031, then was retired). It's equipped and purchased
+-- through the exact same generic flow as every other slot, but excluded
+-- from SLOT_RENDER_ORDER since it paints the Shelf page background, not a
+-- layer on the character canvas — see app/kids/shelf/page.tsx.
+
+alter table public.cosmetic_items drop constraint if exists cosmetic_items_slot_check;
+alter table public.cosmetic_items add constraint cosmetic_items_slot_check
+  check (slot in ('background', 'aura', 'body', 'outfit', 'hair', 'headwear', 'eyewear', 'accessory', 'handheld', 'pet', 'shelf_theme'));
+
+alter table public.cosmetic_items add column if not exists description text;
+
+alter table public.users add column if not exists equipped_aura_id uuid references public.cosmetic_items(id) on delete set null;
+alter table public.users add column if not exists equipped_headwear_id uuid references public.cosmetic_items(id) on delete set null;
+alter table public.users add column if not exists equipped_eyewear_id uuid references public.cosmetic_items(id) on delete set null;
+alter table public.users add column if not exists equipped_handheld_id uuid references public.cosmetic_items(id) on delete set null;
+alter table public.users add column if not exists equipped_shelf_theme_cosmetic_id uuid references public.cosmetic_items(id) on delete set null;
+
+-- Free preset toggles, not tied to cosmetic_items/user_cosmetics at all —
+-- see app/api/kids/character/avatar/route.ts. Skin tone is a hex string
+-- constrained to the 8-swatch palette in lib/character.ts's
+-- SKIN_TONE_SWATCHES so the picker never has to handle an arbitrary color;
+-- update both together if the palette ever changes.
+alter table public.users add column if not exists skin_tone text not null default '#F5D0A9'
+  check (skin_tone in ('#FFE0BD', '#F5D0A9', '#E8B784', '#D2996C', '#B37A4C', '#8D5A34', '#6B4226', '#4A2C17'));
+alter table public.users add column if not exists avatar_body_type text not null default 'default'
+  check (avatar_body_type in ('default', 'tall', 'round', 'petite'));
+
+-- No RLS changes needed: these are plain columns on public.users, already
+-- covered by the users_update_own policy (migration 001) — same as every
+-- other self-service profile field.
+
+-- No starter/launch seed data for the 5 new slots — there's no placeholder
+-- art for them yet (public/character-starters/ only has the original 031
+-- set). Upload some via /admin/cosmetics before these wardrobe tabs will
+-- show anything; the wardrobe already has an empty state for this
+-- ("Nothing here yet — check back for a monthly drop!" in CharacterClient.tsx).
