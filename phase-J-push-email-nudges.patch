diff --git a/public/sw.js b/public/sw.js
index 1d04116..d2e1cc0 100644
--- a/public/sw.js
+++ b/public/sw.js
@@ -70,3 +70,41 @@ self.addEventListener("fetch", (event) => {
       })
   );
 });
+
+// Phase J: streak/event push nudges, sent server-side from
+// app/api/cron/send-nudges (lib/push.ts). Payload is JSON:
+// { title, body, url }. `url` is where notificationclick should land —
+// defaults to the kid dashboard if omitted.
+self.addEventListener("push", (event) => {
+  if (!event.data) return;
+
+  let payload;
+  try {
+    payload = event.data.json();
+  } catch {
+    payload = { title: "Book Buddy", body: event.data.text() };
+  }
+
+  event.waitUntil(
+    self.registration.showNotification(payload.title || "Book Buddy", {
+      body: payload.body || "",
+      icon: "/icons/icon-192.png",
+      badge: "/icons/icon-192.png",
+      data: { url: payload.url || "/kids/home" },
+    })
+  );
+});
+
+self.addEventListener("notificationclick", (event) => {
+  event.notification.close();
+  const targetUrl = event.notification.data?.url || "/kids/home";
+
+  event.waitUntil(
+    self.clients.matchAll({ type: "window", includeUncontrolled: true }).then((clientList) => {
+      for (const client of clientList) {
+        if (client.url.includes(targetUrl) && "focus" in client) return client.focus();
+      }
+      if (self.clients.openWindow) return self.clients.openWindow(targetUrl);
+    })
+  );
+});
diff --git a/supabase/migrations/022_push_subscriptions.sql b/supabase/migrations/022_push_subscriptions.sql
new file mode 100644
index 0000000..636a4fb
--- /dev/null
+++ b/supabase/migrations/022_push_subscriptions.sql
@@ -0,0 +1,28 @@
+-- Phase J: web push subscriptions for daily-streak and weekend-event
+-- nudges. One row per (user, browser/device) — the browser generates a
+-- fresh `endpoint` per subscription, hence the unique constraint doubling
+-- as the upsert key in app/api/push/subscribe.
+
+create table if not exists public.push_subscriptions (
+  id uuid primary key default gen_random_uuid(),
+  user_id uuid not null references public.users(id) on delete cascade,
+  endpoint text not null unique,
+  keys jsonb not null,
+  created_at timestamptz not null default now()
+);
+
+create index if not exists push_subscriptions_user_id_idx on public.push_subscriptions (user_id);
+
+alter table public.push_subscriptions enable row level security;
+
+drop policy if exists "push_subscriptions_select_own" on public.push_subscriptions;
+create policy "push_subscriptions_select_own" on public.push_subscriptions for select
+  using (user_id = auth.uid());
+
+drop policy if exists "push_subscriptions_insert_own" on public.push_subscriptions;
+create policy "push_subscriptions_insert_own" on public.push_subscriptions for insert
+  with check (user_id = auth.uid());
+
+drop policy if exists "push_subscriptions_delete_own" on public.push_subscriptions;
+create policy "push_subscriptions_delete_own" on public.push_subscriptions for delete
+  using (user_id = auth.uid());
