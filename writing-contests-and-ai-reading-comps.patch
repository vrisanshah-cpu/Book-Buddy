+              >
+                {s === "all" ? "All" : STAGE_LABEL[s]}
+              </button>
+            ))}
+          </div>
+        )}
+      </div>
+
+      {error && <p className="mt-3 text-sm text-red-600">{error}</p>}
+
+      {competitionId && (
+        <div className="mt-4 rounded-xl bg-white p-4 shadow-sm">
