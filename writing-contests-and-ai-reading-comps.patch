+}
+interface Contact {
+  submissionId: string;
+  submissionTitle: string;
+  score: number | null;
+  studentId: string | null;
+  studentName: string;
+  studentEmail: string | null;
+  parentEmails: string[];
+}
+
+const STAGE_LABEL: Record<Submission["stage"], string> = {
+  participant: "Participant",
+  semifinalist: "Semifinalist",
+  finalist: "Finalist",
+  top_3: "Top 3 Winner",
