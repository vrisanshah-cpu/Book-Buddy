From 2ac10adc56469d631759fab9749990f21bb46c89 Mon Sep 17 00:00:00 2001
From: Book Buddy Handoff <handoff@bookbuddy.local>
Date: Sat, 8 Aug 2026 17:56:53 +0000
Subject: [PATCH 2/6] chore: allow next/image to load marketplace listing
 photos
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

No other config or dependency changes needed for this version — no
Stripe SDK, no new env vars, no cron job, since nothing processes
payments yet.
---
 next.config.mjs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/next.config.mjs b/next.config.mjs
index e397d02..fe6588c 100644
--- a/next.config.mjs
+++ b/next.config.mjs
@@ -3,6 +3,9 @@ const nextConfig = {
   images: {
     remotePatterns: [
       { protocol: "https", hostname: "covers.openlibrary.org" },
+      // Marketplace listing photos, served from the public
+      // marketplace-listing-photos Supabase Storage bucket (029_marketplace_schema.sql).
+      { protocol: "https", hostname: "**.supabase.co" },
     ],
   },
   experimental: {
