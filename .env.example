NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional — leave empty to use demo reading-game quizzes (no API cost)
ANTHROPIC_API_KEY=

# Ko-fi support button + webhook (both optional — button is hidden if unset)
NEXT_PUBLIC_KOFI_USERNAME=
KOFI_VERIFICATION_TOKEN=

# AdSense ad unit slot ID, used by components/analytics/AdUnit.tsx
# (mounted on the parent dashboard only — see that file for why)
NEXT_PUBLIC_ADSENSE_SLOT_ID=
