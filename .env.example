KOFI_VERIFICATION_TOKEN=

# AdSense footer ad unit (parent dashboard only — optional, hidden if unset)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
